[TEMPLATE]
# 前端运行/构建环境变量示例
# 复制为 .env 后按需修改

# 前端请求的 API 基础路径（构建期注入）
# 开发时经 vite 代理转发；生产由 nginx / serve.mjs 反代
VITE_API_BASE_URL=/api

# 仅开发期生效：vite dev server 将 /api 代理到的后端地址（默认 http://localhost:8080）
VITE_DEV_API_TARGET=http://localhost:8080

# 仅 serve.mjs（静态托管 + API 反代）生效：监听端口与后端目标
PORT=8888
API_TARGET=http://127.0.0.1:8080

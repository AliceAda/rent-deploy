{
  "openapi": "3.0.3",
  "info": {
    "title": "安居租房平台 API（前端契约推导） · 地址 Address",
    "version": "0.1.0-progressive",
    "description": "模块: 地址 Address | 自动从前端契约拆分, 共 5 个接口, 2 个 DTO 组件"
  },
  "servers": [
    {
      "url": "http://localhost:8080",
      "description": "本地后端网关（开发）"
    },
    {
      "url": "https://api.example.com",
      "description": "生产环境（待替换）"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/api/user/address": {
      "get": {
        "tags": [
          "地址 Address"
        ],
        "operationId": "getMyAddresses",
        "summary": "我的地址列表",
        "x-module": "地址",
        "responses": {
          "200": {
            "description": "成功（code=0）",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "integer",
                      "example": 0
                    },
                    "message": {
                      "type": "string",
                      "nullable": true
                    },
                    "data": {
                      "$ref": "#/components/schemas/AddressList"
                    }
                  },
                  "required": [
                    "code",
                    "data"
                  ]
                }
              }
            }
          },
          "401": {
            "description": "未登录/令牌过期，需重新登录"
          },
          "500": {
            "description": "服务器内部错误"
          }
        }
      },
      "post": {
        "tags": [
          "地址 Address"
        ],
        "operationId": "createAddress",
        "summary": "新增地址",
        "x-module": "地址",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AddressItem"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "成功（code=0）",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "integer",
                      "example": 0
                    },
                    "message": {
                      "type": "string",
                      "nullable": true
                    },
                    "data": {
                      "$ref": "#/components/schemas/AddressItem"
                    }
                  },
                  "required": [
                    "code",
                    "data"
                  ]
                }
              }
            }
          },
          "401": {
            "description": "未登录/令牌过期，需重新登录"
          },
          "500": {
            "description": "服务器内部错误"
          }
        }
      }
    },
    "/api/user/address/{id}": {
      "put": {
        "tags": [
          "地址 Address"
        ],
        "operationId": "updateAddress",
        "summary": "更新地址",
        "x-module": "地址",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AddressItem"
              }
            }
          }
        },
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "成功（code=0）",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "integer",
                      "example": 0
                    },
                    "message": {
                      "type": "string",
                      "nullable": true
                    },
                    "data": {
                      "$ref": "#/components/schemas/AddressItem"
                    }
                  },
                  "required": [
                    "code",
                    "data"
                  ]
                }
              }
            }
          },
          "401": {
            "description": "未登录/令牌过期，需重新登录"
          },
          "500": {
            "description": "服务器内部错误"
          }
        }
      },
      "delete": {
        "tags": [
          "地址 Address"
        ],
        "operationId": "deleteAddress",
        "summary": "删除地址",
        "x-module": "地址",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "成功（code=0）",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "integer",
                      "example": 0
                    },
                    "message": {
                      "type": "string",
                      "nullable": true
                    },
                    "data": {
                      "type": "object",
                      "description": "无返回数据（成功仅 code=0）"
                    }
                  },
                  "required": [
                    "code",
                    "data"
                  ]
                }
              }
            }
          },
          "401": {
            "description": "未登录/令牌过期，需重新登录"
          },
          "500": {
            "description": "服务器内部错误"
          }
        }
      }
    },
    "/api/user/address/{id}/default": {
      "put": {
        "tags": [
          "地址 Address"
        ],
        "operationId": "setDefaultAddress",
        "summary": "设为默认",
        "x-module": "地址",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {}
              }
            }
          }
        },
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "成功（code=0）",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "integer",
                      "example": 0
                    },
                    "message": {
                      "type": "string",
                      "nullable": true
                    },
                    "data": {
                      "$ref": "#/components/schemas/AddressItem"
                    }
                  },
                  "required": [
                    "code",
                    "data"
                  ]
                }
              }
            }
          },
          "401": {
            "description": "未登录/令牌过期，需重新登录"
          },
          "500": {
            "description": "服务器内部错误"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "AddressItem": {
        "type": "object",
        "properties": {
          "userId": {
            "type": "number",
            "example": 1
          },
          "contactName": {
            "type": "string",
            "description": "DB: contact_name",
            "example": "示例"
          },
          "phone": {
            "type": "string",
            "description": "DB: phone",
            "example": "13800138000"
          },
          "provinceId": {
            "type": "number",
            "description": "DB: province_id（int，关联 region 表）",
            "example": 1
          },
          "cityId": {
            "type": "number",
            "description": "DB: city_id",
            "example": 1
          },
          "districtId": {
            "type": "number",
            "description": "DB: district_id",
            "example": 1
          },
          "detail": {
            "type": "string",
            "description": "DB: detail",
            "example": "文本"
          },
          "tag": {
            "type": "string",
            "description": "DB: tag（家/公司/其他）",
            "example": "示例"
          },
          "isDefault": {
            "type": "boolean",
            "description": "DB: is_default",
            "example": false
          },
          "createdAt": {
            "type": "string",
            "example": "2024-01-01 00:00:00"
          }
        },
        "required": [
          "contactName",
          "phone",
          "detail",
          "isDefault"
        ]
      },
      "AddressList": {
        "type": "object",
        "properties": {
          "list": {
            "$ref": "#/components/schemas/AddressItem"
          },
          "total": {
            "type": "integer",
            "example": 0,
            "description": "总记录数（分页）"
          }
        },
        "required": [
          "list",
          "total"
        ]
      }
    }
  }
}
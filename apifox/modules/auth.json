{
  "openapi": "3.0.3",
  "info": {
    "title": "安居租房平台 API（前端契约推导） · 认证 Auth",
    "version": "0.1.0-progressive",
    "description": "模块: 认证 Auth | 自动从前端契约拆分, 共 4 个接口, 5 个 DTO 组件"
  },
  "servers": [
    {
      "url": "http://localhost:8080",
      "description": "本地后端网关（开发）"
    },
    {
      "url": "https://api.example.com",
      "description": "生产环境（待替换）"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/api/auth/sms/send": {
      "post": {
        "tags": [
          "认证 Auth"
        ],
        "operationId": "sendSmsCode",
        "summary": "发送短信验证码",
        "x-module": "认证与账户",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SmsSendData"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "成功（code=0）",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "integer",
                      "example": 0
                    },
                    "message": {
                      "type": "string",
                      "nullable": true
                    },
                    "data": {
                      "type": "object",
                      "properties": {
                        "refreshToken": {
                          "type": "string"
                        },
                        "token": {
                          "type": "string"
                        },
                        "userInfo": {
                          "type": "string"
                        }
                      }
                    }
                  },
                  "required": [
                    "code",
                    "data"
                  ]
                }
              }
            }
          },
          "401": {
            "description": "未登录/令牌过期，需重新登录"
          },
          "500": {
            "description": "服务器内部错误"
          }
        }
      }
    },
    "/api/auth/register": {
      "post": {
        "tags": [
          "认证 Auth"
        ],
        "operationId": "register",
        "summary": "注册",
        "x-module": "认证与账户",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RegisterData"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "成功（code=0）",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "integer",
                      "example": 0
                    },
                    "message": {
                      "type": "string",
                      "nullable": true
                    },
                    "data": {
                      "type": "object",
                      "properties": {
                        "id": {
                          "type": "number"
                        }
                      },
                      "required": [
                        "id"
                      ]
                    }
                  },
                  "required": [
                    "code",
                    "data"
                  ]
                }
              }
            }
          },
          "401": {
            "description": "未登录/令牌过期，需重新登录"
          },
          "500": {
            "description": "服务器内部错误"
          }
        }
      }
    },
    "/api/auth/login": {
      "post": {
        "tags": [
          "认证 Auth"
        ],
        "operationId": "login",
        "summary": "登录",
        "x-module": "认证与账户",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginData"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "成功（code=0）",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "integer",
                      "example": 0
                    },
                    "message": {
                      "type": "string",
                      "nullable": true
                    },
                    "data": {
                      "$ref": "#/components/schemas/LoginResult"
                    }
                  },
                  "required": [
                    "code",
                    "data"
                  ]
                }
              }
            }
          },
          "401": {
            "description": "未登录/令牌过期，需重新登录"
          },
          "500": {
            "description": "服务器内部错误"
          }
        }
      }
    },
    "/api/auth/forgot-password": {
      "post": {
        "tags": [
          "认证 Auth"
        ],
        "operationId": "forgotPassword",
        "summary": "忘记密码",
        "x-module": "认证与账户",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ForgotPwdData"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "成功（code=0）",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "integer",
                      "example": 0
                    },
                    "message": {
                      "type": "string",
                      "nullable": true
                    },
                    "data": {
                      "$ref": "#/components/schemas/ForgotPwdData"
                    }
                  },
                  "required": [
                    "code",
                    "data"
                  ]
                }
              }
            }
          },
          "401": {
            "description": "未登录/令牌过期，需重新登录"
          },
          "500": {
            "description": "服务器内部错误"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "ForgotPwdData": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "example": "文本"
          },
          "newPassword": {
            "type": "string",
            "example": "文本"
          }
        },
        "required": [
          "code",
          "newPassword"
        ]
      },
      "LoginData": {
        "type": "object",
        "properties": {
          "password": {
            "type": "string",
            "example": "文本"
          }
        },
        "required": [
          "password"
        ]
      },
      "LoginResult": {
        "type": "object",
        "properties": {
          "refreshToken": {
            "type": "string",
            "example": "文本"
          },
          "userInfo": {
            "type": "object",
            "properties": {
              "id": {
                "type": "number",
                "example": 1
              },
              "name": {
                "type": "string",
                "example": "示例"
              },
              "phone": {
                "type": "string",
                "example": "13800138000"
              },
              "role": {
                "type": "string",
                "example": "示例"
              },
              "avatar": {
                "type": "string",
                "example": "https://example.com/static/demo.jpg"
              },
              "gender": {
                "type": "number",
                "example": 0
              },
              "email": {
                "type": "string",
                "example": "user@example.com"
              }
            },
            "required": [
              "id",
              "name",
              "phone",
              "role"
            ],
            "example": {}
          },
          "expireIn": {
            "type": "number",
            "example": 0
          }
        }
      },
      "RegisterData": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "example": "示例"
          },
          "phone": {
            "type": "string",
            "example": "13800138000"
          },
          "code": {
            "type": "string",
            "example": "文本"
          },
          "password": {
            "type": "string",
            "example": "文本"
          }
        },
        "required": [
          "name",
          "phone",
          "code",
          "password"
        ]
      },
      "SmsSendData": {
        "type": "object",
        "properties": {
          "biz": {
            "type": "string",
            "description": "register / login / reset_pwd / change_phone / change_pwd",
            "example": "文本"
          }
        },
        "required": [
          "biz"
        ]
      }
    }
  }
}
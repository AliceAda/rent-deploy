        ],
        "operationId": "searchHouse",
        "summary": "搜索房源（条件）",
        "x-module": "搜索",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": {
                  "type": "object",
                  "description": "无返回数据"
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "成功（code=0）",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "integer",
                      "example": 0
                    },
                    "message": {
                      "type": "string",
                      "nullable": true
                    },
                    "data": {
                      "type": "object",
                      "properties": {
                        "list": {
                          "type": "array",
                          "items": {
                            "$ref": "#/components/schemas/HouseItem"
                          }
                        },
                        "total": {
                          "type": "number"
                        }
                      },
                      "required": [
                        "list",
                        "total"
                      ]
                    }
                  },
                  "required": [
                    "code",
                    "data"
                  ]
                }
              }
            }
          },
          "401": {
            "description": "未登录/令牌过期，需重新登录"
          },
          "500": {
            "description": "服务器内部错误"
          }
        }
      },

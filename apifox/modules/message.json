{
  "openapi": "3.0.3",
  "info": {
    "title": "安居租房平台 API（前端契约推导） · 消息 Message",
    "version": "0.1.0-progressive",
    "description": "模块: 消息 Message | 自动从前端契约拆分, 共 3 个接口, 1 个 DTO 组件"
  },
  "servers": [
    {
      "url": "http://localhost:8080",
      "description": "本地后端网关（开发）"
    },
    {
      "url": "https://api.example.com",
      "description": "生产环境（待替换）"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/api/message/my": {
      "get": {
        "tags": [
          "消息 Message"
        ],
        "operationId": "getMyMessages",
        "summary": "我的消息列表",
        "x-module": "消息",
        "responses": {
          "200": {
            "description": "成功（code=0）",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "integer",
                      "example": 0
                    },
                    "message": {
                      "type": "string",
                      "nullable": true
                    },
                    "data": {
                      "type": "object",
                      "properties": {
                        "list": {
                          "type": "array",
                          "items": {
                            "$ref": "#/components/schemas/MessageItem"
                          }
                        },
                        "total": {
                          "type": "number"
                        }
                      },
                      "required": [
                        "list",
                        "total"
                      ]
                    }
                  },
                  "required": [
                    "code",
                    "data"
                  ]
                }
              }
            }
          },
          "401": {
            "description": "未登录/令牌过期，需重新登录"
          },
          "500": {
            "description": "服务器内部错误"
          }
        }
      }
    },
    "/api/message/{id}/read": {
      "post": {
        "tags": [
          "消息 Message"
        ],
        "operationId": "readMessage",
        "summary": "单条已读",
        "x-module": "消息",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "成功（code=0）",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "integer",
                      "example": 0
                    },
                    "message": {
                      "type": "string",
                      "nullable": true
                    },
                    "data": {
                      "type": "object",
                      "properties": {
                        "list": {
                          "type": "array",
                          "items": {
                            "$ref": "#/components/schemas/MessageItem"
                          }
                        },
                        "total": {
                          "type": "number"
                        }
                      },
                      "required": [
                        "list",
                        "total"
                      ]
                    }
                  },
                  "required": [
                    "code",
                    "data"
                  ]
                }
              }
            }
          },
          "401": {
            "description": "未登录/令牌过期，需重新登录"
          },
          "500": {
            "description": "服务器内部错误"
          }
        }
      }
    },
    "/api/message/read-all": {
      "post": {
        "tags": [
          "消息 Message"
        ],
        "operationId": "readAllMessages",
        "summary": "全部已读",
        "x-module": "消息",
        "responses": {
          "200": {
            "description": "成功（code=0）",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "integer",
                      "example": 0
                    },
                    "message": {
                      "type": "string",
                      "nullable": true
                    },
                    "data": {
                      "type": "object",
                      "properties": {
                        "list": {
                          "type": "array",
                          "items": {
                            "$ref": "#/components/schemas/MessageItem"
                          }
                        },
                        "total": {
                          "type": "number"
                        }
                      },
                      "required": [
                        "list",
                        "total"
                      ]
                    }
                  },
                  "required": [
                    "code",
                    "data"
                  ]
                }
              }
            }
          },
          "401": {
            "description": "未登录/令牌过期，需重新登录"
          },
          "500": {
            "description": "服务器内部错误"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "MessageItem": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "example": "示例"
          },
          "content": {
            "type": "string",
            "example": "文本"
          },
          "read": {
            "type": "boolean",
            "example": false
          },
          "createTime": {
            "type": "string",
            "example": "2024-01-01 00:00:00"
          }
        },
        "required": [
          "title",
          "content",
          "read",
          "createTime"
        ]
      }
    }
  }
}
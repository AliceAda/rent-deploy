          }
        },
        "required": [
          "reason"
        ]
      },
      "AccountCancelStatus": {
        "type": "object",
        "properties": {
          "reason": {
            "type": "string",
            "example": "文本"
          },
          "applyTime": {
            "type": "string",
            "example": "2024-01-01 00:00:00"
          },
          "cancelAt": {
            "type": "string",
            "example": "2024-01-01 00:00:00"
          }
        }
      },
      "ChangePasswordData": {
        "type": "object",
        "properties": {
          "newPassword": {
            "type": "string",
            "example": "文本"
          },
